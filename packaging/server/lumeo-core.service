[Unit]
Description=Lumeo media core
Wants=network-online.target
After=network-online.target

[Service]
User=lumeo
Group=lumeo
ExecStart=/usr/local/bin/lumeo-core
Environment=LUMEO_DATA=/var/lib/lumeo
Environment=LUMEO_CACHE=/var/cache/lumeo
EnvironmentFile=-/etc/lumeo/core.env
StateDirectory=lumeo
StateDirectoryMode=0700
CacheDirectory=lumeo
CacheDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
